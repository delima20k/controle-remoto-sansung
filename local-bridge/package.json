{
  "name": "controle-tv-local-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Servico local opcional para controlar TVs na rede residencial com pareamento e adaptadores.",
  "main": "lib/src/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "start": "node lib/src/index.js",
    "dev": "npm run build && node lib/src/index.js",
    "test": "npm run build && node --test \"lib/tests/**/*.test.js\""
  },
  "dependencies": {
    "ws": "8.18.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/ws": "8.18.1",
    "typescript": "7.0.2"
  }
}
